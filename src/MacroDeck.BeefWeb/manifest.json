{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.squibs.beefweb",
  "name": "BeefWeb",
  "version": "0.0.1",
  "description": "Connect MacroDeck with your Foobar2000 or DeaDBeeF music player",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "bin/release/net10.0/win-x64/MacroDeck.BeefWeb.exe"
    },
    "osx-arm64": {
      "executable": "bin/release/net10.0/osx-arm64/MacroDeck.BeefWeb"
    },
    "linux-x64": {
      "executable": "bin/release/net10.0/linux-x64/MacroDeck.BeefWeb"
    }
  },
  "publisher": {
    "name": "Squibs",
    "id": "com.squibs",
    "url": "https://www.twitch.tv/squibsland/"
  },
  "license": "MIT",
  "repository": "https://github.com/SquibsLand/MacroDeck-BeefWeb",
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.5"
  },
  "permissions": [
    "host:variables",
    "events:publish"
  ]
}